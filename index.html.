}

.quote{
  background:#fff0f4;
  border-left:4px solid #a51d48;
  padding:15px;
  margin:20px 0;
  font-style:italic;
}

footer{
  background:#4d1728;
  color:white;
  text-align:center;
  padding:25px 15px;
}

.night{
  background:#171317;
  color:#eee;
}

.night .topbar,
.night .home,
.night .chapter,
.night .menu{
  background:#241e23;
  color:#eee;
}

.night .menu a{
  color:#eee;
  border-color:#3b3037;
}

.night .search{
