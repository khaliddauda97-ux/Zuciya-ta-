  border-bottom:1px solid #eee;
}

.menu a:hover{
  background:#f7e4eb;
}

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  z-index:1500;
  display:none;
}

.overlay.show{
  display:block;
}

main{
